{
  "schemaVersion": 1,
  "id": "printer_addon",
  "version": "${mod_version}",
  "name": "Printer Addon",
  "description": "Add-on for Litematica Printer: fixes wrong blocks, builds layer by layer, moves the player, safe build order for farms and buys missing items from a server shop you set up.",
  "authors": [
    "sindrens"
  ],
  "contact": {
    "sources": "https://github.com/sindrens/litematica-printer-addon"
  },
  "license": "AGPL-3.0-only",
  "custom": {
    "printer_addon:edition": "${edition}"
  },
  "icon": "assets/printer_addon/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "no.sindrens.printeraddon.PrinterAddon"
    ],
    "modmenu": [
      "no.sindrens.printeraddon.compat.ModMenuImpl"
    ]
  },
  "mixins": [
    "printer_addon.mixins.json"
  ],
  "depends": {
    "minecraft": ">=26.2 <26.3",
    "fabric-api": "*",
    "malilib": ">=0.29.6- <0.30.0-",
    "litematica": ">=0.28.8- <0.29.0-",
    "litematica_printer": ">=3.2.2"
  }
}
